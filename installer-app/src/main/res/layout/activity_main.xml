<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AutoPlayGM2"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Teste: instala um app de exemplo e tenta fazer ele aparecer na tela do Android Auto do carro. É só apertar o botão abaixo."
        android:textSize="14sp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/installButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textSize="16sp"
        android:text="Instalar app de teste" />

    <Button
        android:id="@+id/checkInstallerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Abrir Android Auto" />

    <Button
        android:id="@+id/debugSpoofButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="[Debug] Tentar spoof + checar installer" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text=""
        android:textSize="14sp" />

</LinearLayout>
