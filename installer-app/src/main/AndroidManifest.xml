<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão pública que qualquer app pode declarar para poder instalar outros APKs
         (com confirmação do usuário via diálogo do sistema). É essa permissão que nos
         torna o "installer de registro" do pacote-alvo, pré-requisito pra depois
         reescrever o campo installerPackageName. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Desde o Android 11, um app só "enxerga" outro pacote instalado via
         PackageManager se declarar isso aqui (filtro de visibilidade de
         pacotes). O test-auto-app fica aqui por precaução; o gearhead
         (Android Auto) é necessário pro botão "Abrir Android Auto" conseguir
         achar o launch intent dele. -->
    <queries>
        <package android:name="com.autoplaygm2.testautoapp" />
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:theme="@style/Theme.AutoPlayGM2Installer">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exigido pela lib do Shizuku pra descobrir o serviço privilegiado
             já rodando no aparelho (instalado e iniciado separadamente, fora
             deste app — ver README). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
